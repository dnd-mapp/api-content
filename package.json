{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@dnd-mapp/api-content",
  "description": "The D&D Mapp content API: a NestJS application that serves the static content of the game, such as races, classes, backgrounds, items, spells, and the rules and mechanics.",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "author": "D&D Mapp",
  "homepage": "https://github.com/dnd-mapp/api-content#readme",
  "bugs": {
    "url": "https://github.com/dnd-mapp/api-content/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnd-mapp/api-content.git"
  },
  "scripts": {
    "start": "nest start --watch",
    "build": "nest build",
    "test": "vitest --ui",
    "test-ci": "vitest run",
    "typecheck": "tsc -b",
    "lint-ts": "eslint",
    "lint-md": "markdownlint-cli2",
    "format": "prettier -w .",
    "format-check": "prettier -c ."
  },
  "engines": {
    "node": "^24.21.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.2",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@nestjs/common": "catalog:nestjs",
    "@nestjs/core": "catalog:nestjs",
    "@nestjs/platform-fastify": "catalog:nestjs",
    "@nestjs/terminus": "catalog:nestjs",
    "reflect-metadata": "catalog:nestjs",
    "rxjs": "catalog:nestjs"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:commitlint",
    "@dnd-mapp/changelog-tools": "catalog:",
    "@dnd-mapp/config-commitlint": "catalog:commitlint",
    "@dnd-mapp/config-eslint": "catalog:eslint",
    "@dnd-mapp/config-markdown": "catalog:markdown",
    "@dnd-mapp/config-prettier": "catalog:prettier",
    "@dnd-mapp/config-typescript": "catalog:",
    "@nestjs/cli": "catalog:nestjs",
    "@nestjs/schematics": "catalog:nestjs",
    "@nestjs/testing": "catalog:nestjs",
    "@swc/cli": "catalog:swc",
    "@swc/core": "catalog:swc",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:vitest",
    "@vitest/ui": "catalog:vitest",
    "eslint": "catalog:eslint",
    "lefthook": "catalog:commitlint",
    "markdownlint-cli2": "catalog:markdown",
    "prettier": "catalog:prettier",
    "prettier-plugin-organize-imports": "catalog:prettier",
    "typescript": "catalog:",
    "vite": "catalog:vitest",
    "vitest": "catalog:vitest"
  }
}
