{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./tsconfig.json",
    "include": ["src"],
    "exclude": ["src/**/*.spec.ts"],
    "compilerOptions": {
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "rootDir": "src"
    }
}
