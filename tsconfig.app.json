{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@dnd-mapp/config-typescript/node",
    "include": ["src"],
    "exclude": ["src/**/*.spec.ts"],
    "compilerOptions": {
        "composite": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "rootDir": "src",
        "verbatimModuleSyntax": true
    }
}
