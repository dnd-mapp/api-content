# Copy this file to `.env`, or to `.env.local` for overrides of your own, and change the values you need. Both files
# stay out of Git. A variable set in the process wins over both files.

# The hostname or IP address that the server listens on. `0.0.0.0` listens on every IPv4 address, so a container can
# be reached from outside.
HOST="0.0.0.0"

# The port that the server listens on, an unprivileged port from 1024 to 65535.
PORT="3000"
